<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Near-black window from launch so there is no white flash before Compose draws. -->
    <style name="Theme.BilateralSleep" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/phosphor_bg</item>
        <item name="android:statusBarColor">@color/phosphor_bg</item>
        <item name="android:navigationBarColor">@color/phosphor_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
